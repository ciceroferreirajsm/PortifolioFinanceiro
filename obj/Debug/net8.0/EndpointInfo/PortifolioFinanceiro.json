  "components": {
    "schemas": {
      "CreateAssetDto": {
        "required": [
          "currentPrice",
          "name",
          "sector",
          "symbol",
          "type"
        ],
        "type": "object",
        "properties": {
          "symbol": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "type": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "sector": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "currentPrice": {
            "minimum": 0,01,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreateMultiplePositionsDto": {
        "required": [
          "positions"
        ],
        "type": "object",
        "properties": {
          "positions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreatePositionDto"
            }
          }
        },
        "additionalProperties": false
      },
      "CreatePortfolioDto": {
        "required": [
          "name",
          "userId"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "userId": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "totalInvestment": {
            "minimum": 0,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreatePositionDto": {
        "required": [
          "assetSymbol",
          "averagePrice",
          "quantity",
          "targetAllocation"
        ],
        "type": "object",
        "properties": {
          "assetSymbol": {
            "minLength": 1,
            "type": "string"
          },
          "quantity": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "averagePrice": {
            "minimum": 0,01,
            "type": "number",
            "format": "double"
          },
          "targetAllocation": {
            "maximum": 1,
            "minimum": 0,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "UpdatePositionDto": {
        "required": [
          "averagePrice",
          "quantity",
          "targetAllocation"
        ],
        "type": "object",
        "properties": {
          "quantity": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "averagePrice": {
            "minimum": 0,01,
            "type": "number",
            "format": "double"
          },
          "targetAllocation": {
            "maximum": 1,
            "minimum": 0,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "UpdatePriceDto": {
        "required": [
          "price"
        ],
        "type": "object",
        "properties": {
          "price": {
            "minimum": 0,01,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    }
  }
